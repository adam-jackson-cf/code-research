{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Manager Role Plan",
  "type": "object",
  "required": [
    "run_id",
    "created_utc",
    "manager",
    "workers"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_utc": {
      "type": "string",
      "minLength": 1
    },
    "manager": {
      "type": "object",
      "required": [
        "name",
        "objective"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "workers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "worker_id",
          "role",
          "question_ids",
          "allowed_domains",
          "blocked_domains",
          "output_files",
          "budget_tokens",
          "escalation_threshold"
        ],
        "properties": {
          "worker_id": {
            "type": "string",
            "pattern": "^W[0-9]{2}$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "question_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "allowed_domains": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blocked_domains": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "output_files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "budget_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "escalation_threshold": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "maximum": 1.0
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
