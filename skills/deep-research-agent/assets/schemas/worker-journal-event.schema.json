{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Worker Journal Event",
  "type": "object",
  "required": [
    "schemaVersion",
    "sequence",
    "eventId",
    "eventType",
    "workerId",
    "claimId",
    "claimText",
    "sourceId",
    "evidence",
    "counterpoint",
    "implication",
    "actionability",
    "confidence",
    "occurredAt",
    "previousEventHash",
    "eventHash"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "eventType": {
      "type": "string",
      "minLength": 1
    },
    "workerId": {
      "type": "string",
      "minLength": 1
    },
    "claimId": {
      "type": "string",
      "minLength": 1
    },
    "claimText": {
      "type": "string",
      "minLength": 1
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "counterpoint": {
      "type": "string",
      "minLength": 1
    },
    "implication": {
      "type": "string",
      "minLength": 1
    },
    "actionability": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "occurredAt": {
      "type": "string",
      "minLength": 1
    },
    "previousEventHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{0,64}$"
    },
    "eventHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
