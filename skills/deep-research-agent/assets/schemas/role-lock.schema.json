{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Role Lock",
  "type": "object",
  "required": [
    "schemaVersion",
    "workerId",
    "role",
    "objective",
    "assignedQuestions",
    "constraints",
    "deliverables",
    "budgetTokens",
    "escalationThreshold",
    "lockHash"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "workerId": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "assignedQuestions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budgetTokens": {
      "type": "integer",
      "minimum": 1
    },
    "escalationThreshold": {
      "type": "number",
      "exclusiveMinimum": 0.0,
      "maximum": 1.0
    },
    "lockHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": true
}
