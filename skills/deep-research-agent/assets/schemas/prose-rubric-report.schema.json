{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Prose Rubric Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "thresholds",
    "scores",
    "overallScore",
    "failingDimensions",
    "rationales"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "thresholds": {
      "type": "object",
      "required": ["minDimension", "minOverall"],
      "properties": {
        "minDimension": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "minOverall": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "scores": {
      "type": "object",
      "required": [
        "clarity",
        "evidence",
        "counterpoint",
        "implication",
        "actionability"
      ],
      "properties": {
        "clarity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "evidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "counterpoint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "implication": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "actionability": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "overallScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 5
    },
    "failingDimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "clarity",
          "evidence",
          "counterpoint",
          "implication",
          "actionability"
        ]
      }
    },
    "rationales": {
      "type": "object",
      "required": [
        "clarity",
        "evidence",
        "counterpoint",
        "implication",
        "actionability"
      ],
      "properties": {
        "clarity": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "counterpoint": {
          "type": "string"
        },
        "implication": {
          "type": "string"
        },
        "actionability": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
