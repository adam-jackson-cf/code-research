{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical Evidence",
  "type": "object",
  "required": ["schemaVersion", "journalCount", "eventCount", "claims"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "journalCount": {
      "type": "integer",
      "minimum": 0
    },
    "eventCount": {
      "type": "integer",
      "minimum": 0
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claimId",
          "claimText",
          "workerIds",
          "sourceIds",
          "evidenceCount",
          "confidence",
          "evidence"
        ],
        "properties": {
          "claimId": {
            "type": "string",
            "minLength": 1
          },
          "claimText": {
            "type": "string",
            "minLength": 1
          },
          "workerIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidenceCount": {
            "type": "integer",
            "minimum": 0
          },
          "confidence": {
            "type": "object",
            "required": ["average", "min", "max"],
            "properties": {
              "average": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "min": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "max": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "eventHash",
                "eventId",
                "eventType",
                "workerId",
                "sourceId",
                "evidence",
                "counterpoint",
                "implication",
                "actionability",
                "confidence",
                "occurredAt",
                "sequence"
              ],
              "properties": {
                "eventHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "eventId": {
                  "type": "string",
                  "minLength": 1
                },
                "eventType": {
                  "type": "string",
                  "minLength": 1
                },
                "workerId": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceId": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "counterpoint": {
                  "type": "string",
                  "minLength": 1
                },
                "implication": {
                  "type": "string",
                  "minLength": 1
                },
                "actionability": {
                  "type": "string",
                  "minLength": 1
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "occurredAt": {
                  "type": "string",
                  "minLength": 1
                },
                "sequence": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
